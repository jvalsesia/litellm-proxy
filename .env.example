# Your actual OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Your actual Gemini API Key (required for Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# The master key you will use to authenticate requests to LiteLLM itself
LITELLM_MASTER_KEY=sk-litellm-master-key-1234

# Redis configuration (used for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
